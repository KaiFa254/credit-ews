# =====================================================================
# .gitattributes — tells Git how to handle files (here: line endings).
# WHY: Windows uses CRLF line endings, Linux/GitHub use LF. Mixing them
#      causes noisy diffs and "LF will be replaced by CRLF" warnings.
# RULE: comments must START the line with #, exactly as in .gitignore.
# =====================================================================

# All text files: detect automatically, always store with LF endings
* text=auto eol=lf

# Exception: Windows batch files must keep CRLF to run correctly
*.bat text eol=crlf

# Binary files: never touch their bytes
*.png binary
*.pbix binary