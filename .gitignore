# =====================================================================
# .gitignore — files and folders Git must NEVER save.
#
# RULES OF THIS FILE (important):
#   - A comment must START the line with #. A # later in a line is NOT a comment;
#     it becomes part of the pattern and breaks the rule.
#   - *      = anything          (e.g. *.db = every file ending in .db)
#   - name/  = a folder          (trailing slash)
#   - !      = exception         ("but DO keep this file")
#   - **     = any depth of subfolders
#
# Principle: commit the RECIPE (code), not the CAKE (data, models, envs).
# Test any rule with:  git check-ignore -v <path>
# =====================================================================

# --- Python cache files (created automatically, never needed in Git) ---
# folders Python creates to speed up imports; rebuilt on every run
__pycache__/
# compiled Python files (.pyc, .pyo, .pyd)
*.py[cod]
# installation metadata created by "pip install -e ."
*.egg-info/
# pytest's memory of the last test run
.pytest_cache/
# ruff's cache
.ruff_cache/
# Jupyter's auto-saved backup copies of notebooks
.ipynb_checkpoints/

# --- Environments (rebuilt from requirements.txt) ---
# Python venvs, if anyone uses one (our conda env lives in AppData, outside this folder)
.venv/
venv/

# --- Data: regenerated by our scripts, NEVER committed ---
# source extracts (in a real bank: confidential)
data/raw/*
# model-ready tables built by the feature pipeline
data/processed/*
# generated data, rebuilt any time from script + seed
data/synthetic/*
# EXCEPTION: keep the placeholder files so the empty folders exist in Git
!data/**/.gitkeep

# --- Outputs: models, reports, databases ---
# trained models (.joblib), rebuilt by the training script
artifacts/models/*
# charts and reports, rebuilt by rerunning the scripts
artifacts/reports/*
# EXCEPTION: keep the placeholders
!artifacts/**/.gitkeep
# database files (our SQLite monitoring mart, Stage 10)
*.db
*.sqlite

# --- Secrets and system files ---
# environment variables: where passwords or keys would live
.env
# junk files created by macOS Finder and Windows Explorer
.DS_Store
Thumbs.db