# =====================================================================
# .gitignore — tells Git which files and folders it must NEVER save.
#
# How to read the patterns:
#   *      = "anything"           (e.g. *.db = every file ending in .db)
#   name/  = a folder             (trailing slash)
#   !      = exception            ("ignore the rule above for THIS file")
#   #      = comment              (Git ignores these lines)
#
# Principle: commit the RECIPE (code), not the CAKE (data, models, envs).
# =====================================================================


# --- Python cache files (created automatically, never needed in Git) ---
__pycache__/            # folders Python creates to speed up imports; rebuilt every run
*.py[cod]               # compiled Python files (.pyc, .pyo, .pyd); [cod] = c, o or d
*.egg-info/             # metadata created when we run "pip install -e ." (Lesson 3)
.pytest_cache/          # pytest's memory of the last test run (Lesson 4)
.ipynb_checkpoints/     # Jupyter's auto-saved backup copies of notebooks


# --- Environments (rebuilt from requirements.txt) ---
.venv/                  # a Python venv, if anyone uses one instead of conda
venv/                   # same, alternative common name
                        # (our conda env lives in AppData, outside this folder)


# --- Data: regenerated by our scripts, never committed ---
data/raw/*              # source extracts — in a real bank, confidential
data/processed/*        # model-ready tables built by the feature pipeline
data/synthetic/*        # generated data — rebuilt anytime from script + seed
!data/**/.gitkeep       # EXCEPT placeholder files, so Git keeps the empty folders
                        # (** = any subfolder depth)


# --- Outputs: models, reports, databases ---
artifacts/models/*      # trained models (.joblib) — rebuilt by the training script
artifacts/reports/*     # charts and reports — rebuilt by rerunning the scripts
!artifacts/**/.gitkeep  # EXCEPT placeholders, so the folders still exist in Git
*.db                    # database files (our SQLite monitoring mart, Stage 10)
*.sqlite                # same, alternative extension


# --- Secrets and system files ---
.env                    # environment variables — where passwords/keys would live
.DS_Store               # junk files created by macOS Finder
Thumbs.db               # junk files created by Windows Explorer (image thumbnails)